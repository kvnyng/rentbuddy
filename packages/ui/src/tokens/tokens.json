{
  "color": {
    "cyan":   { "50": "#EDFBFE", "100": "#D1F4FC", "200": "#A3E9F8", "500": "#46D3F1", "700": "#2B7A92", "900": "#1A4357" },
    "green":  { "50": "#EEFBF2", "100": "#D5F5E0", "200": "#ABECC0", "500": "#57D881", "700": "#357F59", "900": "#1F463F" },
    "yellow": { "50": "#FFF9E8", "100": "#FFF0C4", "200": "#FEE18A", "500": "#FDC214", "700": "#88701F", "900": "#403D26" },
    "coral":  { "50": "#FFF0F0", "100": "#FFD9D9", "200": "#FEB4B2", "500": "#FD6865", "700": "#B85154", "900": "#703A43" },
    "ink":    { "50": "#F6F7F9", "100": "#EEF1F5", "200": "#D5DCE5", "300": "#94A3B8", "400": "#7C8BA1", "500": "#5B6B82", "600": "#475569", "700": "#33415C", "900": "#0E1A2B" },
    "paper": "#FBFAF7",
    "white": "#FFFFFF"
  },
  "semantic": {
    "background": "{color.paper}",
    "surface": "{color.white}",
    "surface-sunken": "{color.ink.100}",
    "surface-panel": "{color.ink.50}",
    "border": "{color.ink.200}",
    "border-input": "{color.ink.400}",
    "border-strong": "{color.ink.500}",
    "divider": "{color.ink.200}",
    "selected-bg": "{color.cyan.50}",
    "selected-fg": "{color.cyan.900}",
    "text": "{color.ink.900}",
    "text-muted": "{color.ink.700}",
    "text-subtle": "{color.ink.500}",
    "primary": "{color.cyan.500}",
    "primary-hover": "{color.cyan.200}",
    "primary-text": "{color.cyan.700}",
    "on-primary": "{color.ink.900}",
    "success": "{color.green.500}",
    "success-text": "{color.green.700}",
    "warning": "{color.yellow.500}",
    "warning-text": "{color.yellow.700}",
    "danger": "{color.coral.500}",
    "danger-text": "{color.coral.700}",
    "focus-ring": "{color.cyan.700}"
  },
  "stage": {
    "tracked":           { "bg": "{color.ink.100}",    "fg": "{color.ink.700}",    "accent": "{color.ink.300}" },
    "contacted":         { "bg": "{color.cyan.100}",   "fg": "{color.cyan.900}",   "accent": "{color.cyan.500}" },
    "viewing-scheduled": { "bg": "{color.yellow.100}", "fg": "{color.yellow.900}", "accent": "{color.yellow.500}" },
    "viewed":            { "bg": "{color.cyan.50}",    "fg": "{color.cyan.900}",   "accent": "{color.cyan.700}" },
    "applied":           { "bg": "{color.green.100}",  "fg": "{color.green.900}",  "accent": "{color.green.500}" },
    "signed":            { "bg": "{color.green.700}",  "fg": "{color.white}",      "accent": "{color.green.500}" },
    "passed":            { "bg": "{color.coral.50}",   "fg": "{color.coral.700}",  "accent": "{color.coral.500}" }
  },
  "font": {
    "heading": "\"Sen\", ui-sans-serif, system-ui, sans-serif",
    "subtitle": "\"Sanchez\", ui-serif, Georgia, serif",
    "body": "\"DM Sans Variable\", \"DM Sans\", ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "size": {
    "xs": "0.75rem", "sm": "0.8125rem", "md": "0.9375rem", "lg": "1.125rem",
    "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem", "4xl": "3rem"
  },
  "weight": { "regular": "400", "medium": "500", "bold": "700", "extrabold": "800" },
  "leading": { "tight": "1.15", "snug": "1.3", "normal": "1.5" },
  "space": {
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem",
    "5": "1.5rem", "6": "2rem", "7": "3rem", "8": "4rem"
  },
  "radius": { "sm": "4px", "md": "6px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(14, 26, 43, 0.05)",
    "md": "0 2px 8px rgba(14, 26, 43, 0.08), 0 1px 2px rgba(14, 26, 43, 0.04)"
  }
}
