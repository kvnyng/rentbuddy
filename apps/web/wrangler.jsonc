// One Worker serves the SPA and the API. Production is the top level; `env.preview`
// is a separate Worker so PR previews use the Clerk development instance, not prod keys.
// Secrets (names only, set by the owner per Worker): CLERK_SECRET_KEY. Local dev: .dev.vars.example.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rentbuddy",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "rentbuddy.pablos.cc", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "https://rentbuddy.pablos.cc",
    // Publishable keys are public. Set once the Clerk production instance exists.
    "CLERK_PUBLISHABLE_KEY": "pk_live_REPLACE_ME"
  },
  "env": {
    "preview": {
      "name": "rentbuddy-preview",
      // `routes` is inherited, so clear it: previews never claim the production domain.
      "routes": [],
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        // Each preview version has its own URL, so the first label is a wildcard.
        "APP_ORIGIN": "https://*-rentbuddy-preview.REPLACE_ME.workers.dev",
        "CLERK_PUBLISHABLE_KEY": "pk_test_REPLACE_ME"
      }
    }
  }
}
